{
	"name": "omp-best-of",
	"version": "0.1.0",
	"description": "Best-of-N coding agents with LLM-as-a-Verifier selection for Oh My Pi",
	"keywords": [
		"oh-my-pi",
		"omp",
		"omp-plugin",
		"coding-agent",
		"best-of-n",
		"llm-as-a-verifier",
		"test-time-scaling",
		"git-worktree",
		"deepseek"
	],
	"homepage": "https://github.com/wolfiesch/omp-best-of#readme",
	"bugs": {
		"url": "https://github.com/wolfiesch/omp-best-of/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfiesch/omp-best-of.git"
	},
	"license": "MIT",
	"author": "Wolfgang Schoenberger (https://github.com/wolfiesch)",
	"type": "module",
	"bin": {
		"omp-best-of": "src/cli.ts"
	},
	"scripts": {
		"check": "bun run check:types && bun run check:catalog && bun run test",
		"check:types": "tsc -p tsconfig.json --noEmit",
		"check:catalog": "bun scripts/validate-catalog.ts",
		"test": "bun test",
		"smoke:verifier": "bun scripts/smoke-verifier.ts"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^17"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "^17.3.4",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"python",
		"README.md",
		"LICENSE",
		"bunfig.toml"
	]
}
