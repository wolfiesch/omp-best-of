{
  "name": "omp-best-of",
  "version": "0.1.0",
  "description": "Best-of-N coding agents with LLM-as-a-Verifier selection for Oh My Pi",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "omp-best-of": "src/cli.ts"
  },
  "scripts": {
    "check": "bun run check:types && bun test",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "smoke:verifier": "bun scripts/smoke-verifier.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.3.4",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "python",
    "README.md",
    "LICENSE"
  ]
}
